{
  "name": "vscode-vditor",
  "version": "3.8.19",
  "description": "♏ 易于使用的 Markdown 编辑器，为适配不同的应用场景而生",
  "author": "cweijan",
  "homepage": "https://b3log.org/vditor",
  "jsdelivr": "dist/index.min.js",
  "main": "dist/index.min.js",
  "funding": "https://ld246.com/sponsor",
  "files": [
    "dist/*",
    "src/index.ts",
    "src/method.ts",
    "src/ts/*",
    "src/assets/*"
  ],
  "dependencies": {
    "diff-match-patch": "1.0.5"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/diff-match-patch": "1.0.32",
    "@types/jest": "^26.0.23",
    "@types/node": "^17.0.19",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-plugin-jest": "^26.1.1",
    "eslint-plugin-prettier": "^4.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^26.6.3",
    "less": "^4.1.2",
    "prettier": "^2.5.1",
    "terser": "^5.37.0",
    "ts-jest": "^26.5.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  },
  "license": "MIT",
  "repository": "git://github.com/Vanessa219/vditor.git",
  "bugs": {
    "url": "https://github.com/Vanessa219/vditor/issues"
  },
  "scripts": {
    "lint": "eslint --fix --ext src/**/*.ts",
    "test:watch": "jest --watch",
    "test": "jest --coverage",
    "start": "vite --config vite.demo.config.ts",
    "build": "vite build && VDITOR_BUILD=method vite build && tsc --emitDeclarationOnly",
    "buildAndCopy": "yarn build && cp dist/index.min.js ../resource/vditor/vditor.js"
  },
  "keywords": [
    "editor",
    "markdown",
    "b3log"
  ]
}
