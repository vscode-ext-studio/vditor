{
  "name": "vscode-vditor",
  "version": "4.0.0",
  "description": "♏ 易于使用的 Markdown 编辑器，为适配不同的应用场景而生",
  "author": "cweijan",
  "homepage": "https://github.com/vscode-ext-studio/vditor",
  "jsdelivr": "dist/index.min.js",
  "main": "dist/index.min.js",
  "files": [
    "dist/*",
    "src/index.ts",
    "src/ts/*",
    "src/assets/*"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "codemirror": "^6.0.2",
    "diff-match-patch": "1.0.5"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/diff-match-patch": "1.0.32",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "eslint": "^8.9.0",
    "less": "^4.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^2.2.0"
  },
  "license": "MIT",
  "repository": "git@github.com:vscode-ext-studio/vditor.git",
  "bugs": {
    "url": "https://github.com/vscode-ext-studio/vditor/issues"
  },
  "scripts": {
    "lint": "eslint --fix --ext src/**/*.ts",
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "buildAndCopy": "yarn build && cp dist/index.min.js ../resource/vditor/vditor.js"
  },
  "keywords": [
    "editor",
    "markdown",
    "vditor"
  ]
}
